# Copy to infra/relay/.env. This file contains secrets; never commit the filled copy.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=example.com
RELAY_DOMAIN=relay.example.com
RELAY_AXIOM_ENABLED=false

# Existing PostgreSQL database, NOT an automatic PlanetScale subscription.
# Apply the included migrations before deployment. Prefer a direct TLS-enabled endpoint.
RELAY_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_AUDIENCE=t3-code-relay

APNS_ENABLED=true
APNS_ENVIRONMENT=production
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_BUNDLE_ID=com.shoreperformance.sp3
APNS_APP_SCHEME=sp3
APNS_PRIVATE_KEY=
RELAY_TUNNEL_CLEANUP_MODE=off
RELAY_LEGACY_TUNNEL_CLEANUP_MODE=off
