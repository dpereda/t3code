# Copy to the repository root as .env.local. Public build identifiers only.
T3CODE_MOBILE_FORK=1
T3CODE_MOBILE_APP_NAME=SP3
T3CODE_MOBILE_BUNDLE_ID=com.shoreperformance.sp3
T3CODE_MOBILE_SCHEME=sp3
T3CODE_MOBILE_SLUG=sp3
T3CODE_MOBILE_VERSION=1.0.0

# Fill these from your own Apple Developer and Expo accounts.
T3CODE_MOBILE_APPLE_TEAM_ID=
T3CODE_MOBILE_EXPO_OWNER=
T3CODE_MOBILE_EAS_PROJECT_ID=
T3CODE_MOBILE_UPDATES_ENABLED=0
# Optional: path relative to apps/mobile to your own app icon PNG.
# T3CODE_MOBILE_ICON=./assets/sp3-icon.png

# Your own Clerk application and deployed relay, never Ping's credentials.
T3CODE_CLERK_PUBLISHABLE_KEY=
T3CODE_CLERK_JWT_TEMPLATE=t3-relay
T3CODE_CLERK_CLI_OAUTH_CLIENT_ID=
T3CODE_RELAY_URL=
# Your Clerk Frontend API hostname, without https://.
T3CODE_MOBILE_CLERK_DOMAIN=
# Optional: only enable with your own apple-app-site-association deployment.
# T3CODE_MOBILE_LINK_DOMAIN=app.example.com

# Keep blank for a private fork without external telemetry.
T3CODE_MOBILE_OTLP_TRACES_URL=
T3CODE_MOBILE_OTLP_TRACES_DATASET=
T3CODE_MOBILE_OTLP_TRACES_TOKEN=
